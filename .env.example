# Copy to .env and edit. Used by docker-compose.yml.

# Host directory to scan. Mounted read-only at /data inside the app container.
SOURCE_DIR=C:\Users\me\Downloads

# Arguments passed to main.py. The directory is always /data in the container;
# --source gives it a stable label so re-runs recognise already-indexed files.
APP_ARGS=upload /data --source Downloads
